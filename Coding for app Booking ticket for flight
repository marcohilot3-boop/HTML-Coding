<html> 
    <head>
        <title>Demo Ticket</title>
    </head>

    <body>
        <header>
            <h1>Ticket Ordering System</h1>
        </header>
        <hr>

        <section>
            <form>
                <p>Enter Passenger Name:
                    <input type = "text" id = "name" placeholder = "Enter Name" required> <br> <br>

                    Destination:
                    <select id = "destination" required>
                        <option value = "Manila">Manila - 100</option>
                        <option value = "Pasay">Pasay - 150</option>
                        <option value = "Quezon">Quezon - 200</option>
                    </select> <br> <br>

                    Ticket Type:
                    <select id = "Ticket Type" required>
                        <option value = "one">One-way</option>
                        <option value = "two">Two-way</option>
                    </select> <br> <br>

                    Number of Passengers:
                    <input type = "number" id = "quant" placeholder = "Enter Number of Passengers" required> <br> <br>

                    <input type = "button" value = "Book Ticket" onClick = "Process()"> <br> <br>

                </p>
            </form>
                <h1>Ticket Summary</h1>
                <p id = "output"></p>
                <hr>
            </section>

        <script>
            function Process(){
                var name = document.getElementById("name").value;
                var destination = document.getElementById("destination").value;
                var ticketType = document.getElementById("Ticket Type").value;
                var quant = Number(document.getElementById("quant").value);

                if (destination == "Manila"){
                    var price = 100;
                }
                else if (destination == "Pasay"){

                    var price = 150;
                }
                else if (destination == "Quezon"){

                    var price = 200;
                }
                else if (ticketType == "two"){
                    var fare = price * 2;
                }

                var total = quant + price + destination;

                
                document.getElementById("output").innerHTML = "Customer name: " + name + "<br>" + 
                "Destination: " + destination + "<br>" + "Ticket Type: " + ticketType + "<br>" + 
                "Number of Passengers: " + quant + "<br>" + "Total: " + total;

            }
        </script>
</html>